DATABASE_URL=postgresql://localhost:5432/tradersho_dev
PORT=3001

# Optional password recovery. Disabled until all three values are configured.
APP_PUBLIC_URL=https://your-panel.example.com
RECOVERY_EMAIL_URL=
RECOVERY_EMAIL_SECRET=

# Set internal + a random secret (at least 32 chars) to require a login CAPTCHA.
CAPTCHA_MODE=
CAPTCHA_SECRET=


# Shared official calendar import; optional until configured. Generate a random >=32-character token.
CALENDAR_INGEST_TOKEN=

# Direct SMTP for password recovery and agent reply notifications. Empty = disabled.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
# 32 random bytes as 64 hex characters. Keep stable while queued messages exist.
MAIL_ENCRYPTION_KEY=
# Global spacing between messages (default 12/minute); confirm host plan limits.
MAIL_INTERVAL_MS=5000
