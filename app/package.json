{
  "name": "tradersho-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "check": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-release.mjs",
    "test:ui": "node scripts/audit-ui.mjs",
    "test:ui:states": "node scripts/qa-ui-states.mjs",
    "test:e2e:support": "node scripts/e2e-support.mjs",
    "test:e2e:legacy": "node scripts/e2e.mjs",
    "test:unit": "node --test src/analysis/indicators.test.ts server/simulation.test.mjs server/candle.test.mjs src/workspace/indicators.test.ts src/calendar/format.test.ts server/calendar.test.mjs server/mail.test.mjs",
    "test:e2e:candles": "node scripts/e2e-candles.mjs",
    "test:ui:mobile": "MOBILE_AUDIT=1 node scripts/audit-ui.mjs",
    "test:ui:wide": "WIDE_AUDIT=1 node scripts/audit-ui.mjs",
    "test:e2e:recovery": "node scripts/e2e-recovery.mjs",
    "test:e2e:mail": "node scripts/ci-mail.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
