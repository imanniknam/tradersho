[Unit]
Description=Backup Tradersho mail management configuration and MFA state
After=docker.service
[Service]
Type=oneshot
ExecStart=/bin/sh /opt/tradersho-owner-mail/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tradersho-owner-mail/snapshots
