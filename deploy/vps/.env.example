# Keep the real file at /opt/tradersho/.env, chmod 600, outside this repository.
# Use a generated HEX password (openssl rand -hex 32) to avoid URL escaping issues.
POSTGRES_PASSWORD=
PANEL_DOMAIN=my.tradersho.com
SERVER_IP=109.122.254.172
DEPLOY_ROOT=/opt/tradersho
RECOVERY_EMAIL_URL=
RECOVERY_EMAIL_SECRET=

CAPTCHA_SECRET=


# Direct SMTP for password recovery and agent reply notifications. Empty = disabled.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
# 32 random bytes as 64 hex characters. Keep stable while queued messages exist.
MAIL_ENCRYPTION_KEY=
# Global spacing between messages (default 12/minute); confirm host plan limits.
MAIL_INTERVAL_MS=5000
